# Frontend/backend public URLs
ALI_PMO_PUBLIC_APP_URL=https://your-netlify-site.netlify.app
ALI_PMO_PUBLIC_API_URL=https://your-ali-pmo-api.example.com
ALI_PMO_CORS_ORIGINS=https://your-netlify-site.netlify.app,http://localhost:5173,http://127.0.0.1:5173

# Payment gate
ALI_PMO_PAYMENT_REQUIRED=true
ALI_PMO_BILLING_PROVIDER=tap

# Tap Payments
TAP_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
TAP_MERCHANT_ID=
TAP_API_BASE_URL=https://api.tap.company/v2
TAP_SOURCE_ID=src_all
# Set true only after Tap enables Save Card on your merchant account.
TAP_SAVE_CARD=false
TAP_PLAN_AMOUNT=1.000
TAP_PLAN_CURRENCY=OMR
TAP_PLAN_INTERVAL_DAYS=30

# Lemon Squeezy. Use a test-mode key while your store is being approved.
# Create a monthly subscription product in the Lemon Squeezy dashboard first.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true
LEMONSQUEEZY_PLAN_AMOUNT_CENTS=100
LEMONSQUEEZY_PLAN_CURRENCY=USD
